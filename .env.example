# Copy relevant values into backend/.env and frontend/.env.local — never commit real secrets.

# --- backend/.env ---
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require
DEEPGRAM_API_KEY=
# Cartesia TTS — powers the voice agent's spoken replies (/ws/agent only;
# /ws/live never speaks, it only listens). Leave blank and the agent
# degrades to text-only turns (see services/tts.py).
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-latest
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b-cloud
SCORING_WEIGHTS={"needs_discovery":0.25,"product_knowledge":0.15,"objection_handling":0.15,"compliance":0.20,"trial_booking":0.15,"rapport_building":0.10}
SEVERITY_PENALTIES={"critical":15,"major":8,"minor":3}
MAX_RETRIES=3
STUCK_CALL_TIMEOUT_MINUTES=10
POLL_INTERVAL_SECONDS=5
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
# Backblaze B2 (S3-compatible) — optional, durable copy of uploaded audio so
# it survives a host restart. Leave blank to run local-disk-only (fine for
# dev; see README's "what's real vs simplified").
B2_ENDPOINT_URL=
B2_BUCKET_NAME=
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- frontend/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:8000
